# Copy to .env and fill in from https://dashboard.stripe.com/test/apikeys
# Use test keys (sk_test_ / pk_test_) while developing.
STRIPE_SECRET_KEY=sk_test_...   # or a restricted key rk_test_... (needs PaymentIntents write)
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Optional: lets Stripe push payment updates to /api/stripe/webhook.
# Locally: `stripe listen --forward-to localhost:5173/api/stripe/webhook` prints this secret.
STRIPE_WEBHOOK_SECRET=

# Optional: "Add to Google Wallet" on the confirmation page. Issuer ID from
# https://pay.google.com/business/console and a service account JSON key with access to it.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_KEY_FILE=
