{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "eurailo",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "eurailo-alt",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "concurrently",
        "-k",
        "npm:dev:api",
        "vite --port 5180 --strictPort"
      ],
      "port": 5180
    },
    {
      "name": "eurailo-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port",
        "5190",
        "--strictPort"
      ],
      "port": 5190
    },
    {
      "name": "eurailo-ui",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port",
        "5190",
        "--strictPort"
      ],
      "port": 5190
    }
  ]
}